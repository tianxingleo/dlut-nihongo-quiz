# ── scripts/enrich-explanations.mjs（既有，勿动）─────────────────────────
# Required by scripts/enrich-explanations.mjs
# Get yours at https://platform.deepseek.com (or any Anthropic-compatible provider)
ANTHROPIC_AUTH_TOKEN=sk-your-key-here
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash

# ── pdf-ocr 工作流（docs/pdf-ocr-pipeline.md §2.4）───────────────────────
# 只放 API 相关的三项 × 2 组：端点 / 模型版本 / 密钥。
# 其它配置（dpi、页范围、重试次数、分类名）一律走命令行参数。
# 取值优先级：.env > 进程环境变量 > 代码内默认值（下列端点与模型即为默认值）。
# 用法：cp .env.example .env，然后把两个 API key 填上。
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1/chat/completions
STEPFUN_MODEL=step-3.7-flash
STEPFUN_API_KEY=

# 该端点 /v1/models 只提供 deepseek-flash 与 deepseek-v4-pro；写别的名字会 HTTP 400。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
